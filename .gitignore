# virtualenv (517MB, recreate locally with: python -m venv eye)
eye/

# secrets - never commit, see .env.example for the expected keys
.env

# runtime data - regenerated locally, not source
data/eyegod.db
data/calibration.json

# python
__pycache__/
*.pyc

# OS / editor junk
.DS_Store
.ipynb_checkpoints/

# stale local build artifact - redundant now that the repo itself is the source of truth
EyeGod_source.zip

# 개발 중 트러블슈팅 기록 - 로컬 참고용으로만 두기로 함, 팀 공유용 doc/는 아님
doc/트러블슈팅_히스토리.md

# Kaggle datasets for future model training - local only, not part of the repo
cataract/
conjunctivitis/

# AI/ training data + run outputs - curated locally, large binaries, not part of the repo
AI/cataract/
AI/redness/
AI/runs/

# 학습된 모델 폴더들. 가중치(.pt)와 코드는 추적하고, 학습 데이터셋과 테스트/결과
# 이미지는 제외한다 - 데이터셋은 용량도 크지만 저작권이 확인되지 않은 원본이
# 섞여있을 수 있어서 로컬 전용이다 (AI/README.txt, 위 AI/ 규칙과 같은 이유).
# test_image.jpg 류도 스톡 사진 워터마크가 찍힌 것이 있어 함께 제외한다.
models/eye_seg/*
!models/eye_seg/*.py
!models/eye_seg/eye_seg.pt

models/cataract_cls/*
!models/cataract_cls/*.py
!models/cataract_cls/*.ipynb
!models/cataract_cls/best.pt

# Python<->JS 수치 일치 테스트가 실행 중에 만들어내는 것들 (run.sh 가 매번 재생성).
# fixture.json 은 4MB 가까이 되고, vision/ 은 원본을 그대로 복사한 사본이다.
tests/vision_parity/fixture.json
tests/vision_parity/vision/

# 리듬게임 디자인 참고용으로 모아둔 상용 게임 스크린샷 (워터마크 포함).
# 저작권이 확인되지 않은 제3자 이미지라 저장소에 올리지 않는다 - 로컬 참고용.
# 어떤 자료를 참고했는지는 rhythm_new.txt 에 기록해둠.
reference_img/

# 브라우저용 MediaPipe 자산 (WASM 엔진 + 모델 사본, 약 38MB).
# scripts/setup_mediapipe.py 로 각자 로컬에 받는다 - 저장소에는 올리지 않음.
web/frontend/vendor/
tests/rhythm_parity/fixture.json
tests/rhythm_parity/rhythm/
tests/gaze_parity/fixture.json
tests/gaze_parity/gaze/
