# Copy this file to .env and fill in real values. .env is loaded automatically by web/backend/app.py.

# Naver Cloud Platform > AI/Application Service > Maps > Dynamic Map application Client ID.
# Register http://localhost:8000 as the service URL for local development.
NAVER_MAP_CLIENT_ID=

# Same NCP Maps application as above - open it in the console, enable "Geocoding"
# among its services if not already checked, and copy the Client Secret here.
# Powers the region-name search boxes (home header, home map preview, hospitals.html).
NAVER_MAP_CLIENT_SECRET=

# data.go.kr HIRA (건강보험심사평가원) 병원정보서비스 service key.
# Leave empty to use mock clinic data instead of a live lookup.
HIRA_API_KEY=

# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web application).
# Authorized redirect URI must be http://localhost:8000/api/auth/google/callback for local dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao Developers > my application > [앱] > [플랫폼 키] > REST API 키 카드.
# "카카오 로그인 리다이렉트 URI" must be http://localhost:8000/api/auth/kakao/callback for local dev.
# KAKAO_CLIENT_SECRET is only required if "클라이언트 시크릿 > 카카오 로그인" is activated.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Random secret used to sign the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
